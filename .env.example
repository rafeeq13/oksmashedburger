# ── Copy to .env and adjust. docker-compose reads this file. ──────────────
# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# Database (docker-compose service name = db)
POSTGRES_USER=oksb
POSTGRES_PASSWORD=oksb
POSTGRES_DB=oksb
DATABASE_URL=postgresql+psycopg2://oksb:oksb@db:5432/oksb

# Redis (cache, queues, socket.io backbone)
REDIS_URL=redis://redis:6379/0

# Payments: true = simulate charges (no real Stripe call) so the flow works
# before real keys are added. Set to false once each store's Stripe keys are live.
DEMO_PAYMENTS=true

# ── Brand-level integration keys (per-store keys live in the DB, see
#    StoreIntegration — "each location has its own integrations"). These are
#    fallbacks / platform-level defaults. Leave blank until provided. ────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SQUARE_ACCESS_TOKEN=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
FIREBASE_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
